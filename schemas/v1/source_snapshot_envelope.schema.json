{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zcira:source-snapshot-envelope:1.0.0",
  "title": "ZCIRA Metadata-Only Immutable Source Snapshot Envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "const": "ZCIRA-2026-11-13"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snapshot-[a-z0-9][a-z0-9-]{2,80}$"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^?#]+$",
      "maxLength": 2048
    },
    "source_url_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_domain": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$",
      "maxLength": 253
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "page_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "http_status": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        {
          "type": "null"
        }
      ]
    },
    "body_digest_algorithm": {
      "const": "SHA-256"
    },
    "raw_body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "raw_body_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "excerpt": {
      "type": "string",
      "maxLength": 2000
    },
    "fetch_status": {
      "enum": [
        "CAPTURED",
        "UNAVAILABLE",
        "BLOCKED_BY_POLICY",
        "CHANGED",
        "ERROR"
      ]
    },
    "trust_boundary": {
      "const": "UNTRUSTED_DATA_ONLY"
    },
    "access_mode": {
      "const": "PUBLIC_READ_ONLY"
    },
    "access_control_bypass": {
      "const": false
    },
    "reviewer_verdict": {
      "const": "PENDING"
    },
    "commercial_gate_status": {
      "const": "UNKNOWN"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 245
            },
            {
              "type": "null"
            }
          ]
        },
        "destination_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "source_row_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "source_line": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "archive_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "category_id",
        "destination_id",
        "source_row_ref",
        "source_line",
        "archive_sha256"
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "METADATA_ONLY"
        },
        "raw_body_persisted": {
          "const": false
        },
        "raw_body_disposition": {
          "const": "EPHEMERAL_HASH_PARSE_DISCARD"
        },
        "query_and_fragment_persisted": {
          "const": false
        },
        "full_page_mirroring": {
          "const": false
        },
        "excerpt_redaction_policy": {
          "const": "ZCIRA_REDACTION_V1"
        }
      },
      "required": [
        "mode",
        "raw_body_persisted",
        "raw_body_disposition",
        "query_and_fragment_persisted",
        "full_page_mirroring",
        "excerpt_redaction_policy"
      ]
    },
    "canonicalization": {
      "const": "ZCIRA_JSON_CANONICAL_V1"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "snapshot_id",
    "source_url",
    "source_url_sha256",
    "source_domain",
    "publisher",
    "page_title",
    "captured_at",
    "last_updated_at",
    "http_status",
    "body_digest_algorithm",
    "raw_body_sha256",
    "raw_body_size_bytes",
    "excerpt",
    "fetch_status",
    "trust_boundary",
    "access_mode",
    "access_control_bypass",
    "reviewer_verdict",
    "commercial_gate_status",
    "provenance",
    "retention",
    "canonicalization"
  ]
}
