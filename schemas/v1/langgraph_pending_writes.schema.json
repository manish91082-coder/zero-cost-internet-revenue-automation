{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zcira:langgraph-pending-writes:1.0.0",
  "title": "ZCIRA LangGraph Pending Writes Object Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "const": "ZCIRA-2026-11-13"
    },
    "run_id": {
      "type": "string",
      "pattern": "^zcira-run-[a-z0-9][a-z0-9-]{2,80}$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^zcira-run-[a-z0-9][a-z0-9-]{2,80}$"
    },
    "checkpoint_ns": {
      "const": ""
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "pending_write_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_path": {
      "type": "string",
      "maxLength": 512
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "writes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "project_id",
              "mission_id",
              "canonical_repo",
              "branch",
              "environment_namespace",
              "state_namespace",
              "mission_context",
              "run_id",
              "now",
              "started_at",
              "tasks",
              "provider_records",
              "active_leases",
              "completed_task_ids",
              "blocked_task_ids",
              "base_commit_sha",
              "executor",
              "run_mode",
              "kill_switch",
              "cancel_requested",
              "status",
              "pause_reason",
              "research_plan",
              "selected_task_ids",
              "pending_task_ids",
              "blocked_reasons",
              "publisher_candidate",
              "publisher_handoff",
              "checkpoint_proposal",
              "source_worker_execution_enabled",
              "source_worker_proposals",
              "source_worker_status",
              "source_worker_errors",
              "source_worker_batch_proposal",
              "write_performed",
              "__error__",
              "__interrupt__",
              "__resume__",
              "__scheduled__",
              "__start__"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": -4,
            "maximum": 63
          },
          "value": true
        },
        "required": [
          "channel",
          "index",
          "value"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "thread_id",
    "checkpoint_ns",
    "checkpoint_id",
    "pending_write_id",
    "task_id",
    "task_path",
    "created_at",
    "writes"
  ]
}
