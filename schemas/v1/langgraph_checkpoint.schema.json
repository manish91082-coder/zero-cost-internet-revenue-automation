{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zcira:langgraph-checkpoint:1.0.0",
  "title": "ZCIRA LangGraph Checkpoint Object Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "const": "ZCIRA-2026-11-13"
    },
    "run_id": {
      "type": "string",
      "pattern": "^zcira-run-[a-z0-9][a-z0-9-]{2,80}$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^zcira-run-[a-z0-9][a-z0-9-]{2,80}$"
    },
    "checkpoint_ns": {
      "const": ""
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "parent_checkpoint_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "channel_values": {
          "type": "object",
          "propertyNames": {
            "oneOf": [
              {
                "enum": [
                  "project_id",
                  "mission_id",
                  "canonical_repo",
                  "branch",
                  "environment_namespace",
                  "state_namespace",
                  "mission_context",
                  "run_id",
                  "now",
                  "started_at",
                  "tasks",
                  "provider_records",
                  "active_leases",
                  "completed_task_ids",
                  "blocked_task_ids",
                  "base_commit_sha",
                  "executor",
                  "run_mode",
                  "kill_switch",
                  "cancel_requested",
                  "status",
                  "pause_reason",
                  "research_plan",
                  "selected_task_ids",
                  "pending_task_ids",
                  "blocked_reasons",
                  "publisher_candidate",
                  "publisher_handoff",
                  "checkpoint_proposal",
                  "source_worker_execution_enabled",
                  "source_worker_proposals",
                  "source_worker_status",
                  "source_worker_errors",
                  "source_worker_batch_proposal",
                  "write_performed",
                  "__start__"
                ]
              },
              {
                "type": "string",
                "pattern": "^branch:to:(?:[a-z][a-z0-9_-]{0,63}|__end__)$"
              }
            ]
          },
          "additionalProperties": true
        },
        "channel_versions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "versions_seen": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "pending_sends": {
          "type": "array",
          "maxItems": 64,
          "items": true
        },
        "updated_channels": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 256
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "v",
        "id",
        "ts",
        "channel_values",
        "channel_versions",
        "versions_seen"
      ]
    },
    "metadata": {
      "type": "object"
    },
    "new_versions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "thread_id",
    "checkpoint_ns",
    "checkpoint_id",
    "parent_checkpoint_id",
    "checkpoint_index",
    "created_at",
    "checkpoint",
    "metadata",
    "new_versions"
  ]
}
