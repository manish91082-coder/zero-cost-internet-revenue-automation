{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zcira:source-worker-proposal:1.0.0",
  "title": "ZCIRA Read-only LangGraph Source Worker Proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "const": "ZCIRA-2026-11-13"
    },
    "task_id": {
      "type": "string",
      "pattern": "^zcira-[a-z0-9][a-z0-9-]{2,100}$",
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assigned_role": {
      "enum": [
        "official_source_worker_a",
        "official_source_worker_b"
      ]
    },
    "result_status": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snapshot-[a-z0-9][a-z0-9-]{2,80}$"
    },
    "source_snapshot_envelope": {
      "type": "object"
    },
    "source_snapshot_content_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_snapshot_storage_path": {
      "type": "string",
      "pattern": "^evidence/snapshots/sha256/[a-f0-9]{64}\\.json$"
    },
    "source_snapshot_envelope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_proposal": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_body_persisted": {
      "const": false
    },
    "write_performed": {
      "const": false
    },
    "requires_s7_publisher": {
      "const": true
    },
    "reviewer_verdict": {
      "const": "PENDING"
    },
    "commercial_gate_status": {
      "const": "UNKNOWN"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "task_id",
    "idempotency_key",
    "assigned_role",
    "result_status",
    "snapshot_id",
    "source_snapshot_envelope",
    "source_snapshot_content_ref",
    "source_snapshot_storage_path",
    "source_snapshot_envelope_sha256",
    "evidence_proposal",
    "raw_body_persisted",
    "write_performed",
    "requires_s7_publisher",
    "reviewer_verdict",
    "commercial_gate_status",
    "proposal_sha256"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "result_status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "result_status"
        ]
      },
      "then": {
        "properties": {
          "evidence_proposal": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "evidence_proposal": {
            "type": "null"
          }
        }
      }
    }
  ]
}
