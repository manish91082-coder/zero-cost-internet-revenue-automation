{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zcira:quota-ledger:1.0.0",
  "title": "ZCIRA Provider Quota and Circuit Breaker Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "const": "ZCIRA-2026-11-13"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "provider_type": {
      "enum": [
        "LLM",
        "EXECUTOR",
        "SCHEDULER",
        "STORAGE",
        "REPOSITORY"
      ]
    },
    "provider_plan": {
      "const": "FREE"
    },
    "verified_free": {
      "type": "boolean"
    },
    "billing_required": {
      "type": "boolean"
    },
    "payment_method_required": {
      "type": "boolean"
    },
    "trial_credit_dependency": {
      "const": false
    },
    "paid_fallback_allowed": {
      "const": false
    },
    "approved_for_use": {
      "type": "boolean"
    },
    "verified_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "quota_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requests_per_day": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tokens_per_day": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cpu_ms_per_invocation": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "job_minutes_per_month": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "storage_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "requests_per_minute",
        "requests_per_day",
        "tokens_per_day",
        "cpu_ms_per_invocation",
        "job_minutes_per_month",
        "storage_bytes"
      ]
    },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_today": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_today": {
          "type": "integer",
          "minimum": 0
        },
        "job_minutes_this_month": {
          "type": "integer",
          "minimum": 0
        },
        "storage_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "requests_today",
        "tokens_today",
        "job_minutes_this_month",
        "storage_bytes"
      ]
    },
    "circuit_breaker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "NOT_VERIFIED",
            "CLOSED",
            "OPEN",
            "HALF_OPEN",
            "BLOCKED"
          ]
        },
        "failure_count": {
          "type": "integer",
          "minimum": 0
        },
        "opened_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_retry_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "required": [
        "state",
        "failure_count",
        "opened_at",
        "next_retry_at",
        "reason"
      ]
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "provider_id",
    "provider_type",
    "provider_plan",
    "verified_free",
    "billing_required",
    "payment_method_required",
    "trial_credit_dependency",
    "paid_fallback_allowed",
    "approved_for_use",
    "verified_at",
    "verification_source_ids",
    "quota_limits",
    "consumption",
    "circuit_breaker",
    "blocked_reason"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verified_free": {
            "const": true
          }
        },
        "required": [
          "verified_free"
        ]
      },
      "then": {
        "properties": {
          "verification_source_ids": {
            "minItems": 1
          },
          "verified_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "billing_required": {
                "const": true
              }
            },
            "required": [
              "billing_required"
            ]
          },
          {
            "properties": {
              "payment_method_required": {
                "const": true
              }
            },
            "required": [
              "payment_method_required"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "approved_for_use": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "circuit_breaker": {
            "properties": {
              "state": {
                "const": "OPEN"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "circuit_breaker"
        ]
      },
      "then": {
        "properties": {
          "approved_for_use": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verified_free": {
            "const": false
          }
        },
        "required": [
          "verified_free"
        ]
      },
      "then": {
        "properties": {
          "approved_for_use": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "circuit_breaker": {
            "properties": {
              "state": {
                "enum": [
                  "NOT_VERIFIED",
                  "OPEN",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "circuit_breaker"
        ]
      },
      "then": {
        "properties": {
          "approved_for_use": {
            "const": false
          }
        }
      }
    }
  ]
}
